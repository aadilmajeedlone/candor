{
  "name": "candor",
  "productName": "Candor",
  "version": "0.1.0",
  "description": "Interview preparation and low-latency live answer assistance for the desktop",
  "author": "Candor",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:speech": "vitest run --config vitest.speech.config.ts tests/speech/stt-local-real.test.ts",
    "test:local-llm": "vitest run --config vitest.local.config.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:speech",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:stt": "vitest run --config vitest.speech.config.ts tests/speech/stt-local.bench.ts",
    "bench:robustness": "vitest run --config vitest.speech.config.ts tests/speech/stt-robustness.bench.ts",
    "models": "node scripts/fetch-models.mjs",
    "models:verify": "node scripts/fetch-models.mjs --verify",
    "llm:fetch": "node scripts/fetch-llm.mjs",
    "speech:fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-speech-fixtures.ps1",
    "predist": "npm run models:verify",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "predist:dir": "npm run models:verify",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "google-auth-library": "^11.1.0",
    "sherpa-onnx-node": "^1.13.8",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
